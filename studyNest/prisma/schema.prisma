/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model study_areas {
  study_area_id                String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  area_name                    String                         @unique @db.VarChar(100)
  building                     String?                        @db.VarChar(50)
  floor                        Int?
  capacity                     Int?
  latitude                     Float?
  longitude                    Float?
  radius_meters                Int?                           @default(20)
  wifi                         Boolean?                       @default(false)
  charging_ports               Boolean?                       @default(false)
  silent_zone                  Boolean?                       @default(false)
  ac                           Boolean?                       @default(false)
  is_active                    Boolean?                       @default(true)
