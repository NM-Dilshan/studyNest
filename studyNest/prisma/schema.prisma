generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model complaint_updates {
  complaint_update_id Int        @id @default(autoincrement())
  complaint_id        Int
  updated_by          String     @db.Uuid
  update_message      String
  new_status          String?    @db.VarChar(20)
  created_at          DateTime?  @default(now()) @db.Timestamp(6)
  complaints          complaints @relation(fields: [complaint_id], references: [complaint_id], onDelete: NoAction, onUpdate: NoAction)
  users               users      @relation(fields: [updated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model complaints {
  complaint_id      Int                 @id @default(autoincrement())
  student_id        String              @db.Uuid
  hall_id           String?             @db.Uuid
  study_area_id     String?             @db.Uuid
  issue_category    String              @db.VarChar(50)
  description       String
  photo_url         String?
  status            String?             @default("Pending") @db.VarChar(20)
  created_at        DateTime?           @default(now()) @db.Timestamp(6)
  complaint_updates complaint_updates[]
  lecture_halls     lecture_halls?      @relation(fields: [hall_id], references: [hall_id], onDelete: NoAction, onUpdate: NoAction)
  users             users               @relation(fields: [student_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  study_areas       study_areas?        @relation(fields: [study_area_id], references: [study_area_id], onDelete: NoAction, onUpdate: NoAction)
}

model favorite_halls {
  favorite_hall_id Int           @id @default(autoincrement())
  student_id       String        @db.Uuid
  hall_id          String        @db.Uuid
  created_at       DateTime?     @default(now()) @db.Timestamp(6)
  lecture_halls    lecture_halls @relation(fields: [hall_id], references: [hall_id], onDelete: NoAction, onUpdate: NoAction)
  users            users         @relation(fields: [student_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, hall_id])
}

model favorite_study_areas {
  favorite_area_id Int         @id @default(autoincrement())
  student_id       String      @db.Uuid
  study_area_id    String      @db.Uuid
  created_at       DateTime?   @default(now()) @db.Timestamp(6)
  users            users       @relation(fields: [student_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  study_areas      study_areas @relation(fields: [study_area_id], references: [study_area_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, study_area_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model hall_usage_logs {
  hall_usage_id   Int           @id @default(autoincrement())
  hall_id         String        @db.Uuid
  source_type     String        @db.VarChar(30)
  usage_status    String        @db.VarChar(20)
  occupancy_count Int?
  recorded_at     DateTime?     @default(now()) @db.Timestamp(6)
  lecture_halls   lecture_halls @relation(fields: [hall_id], references: [hall_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model lecture_halls {
  hall_id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hall_name              String                   @unique @db.VarChar(30)
  building               String?                  @db.VarChar(50)
  floor                  Int?
  capacity               Int?
  hall_type              String?                  @default("lecture_hall") @db.VarChar(20)
  projector              Boolean?                 @default(false)
  wifi                   Boolean?                 @default(false)
  ac                     Boolean?                 @default(false)
  whiteboard             Boolean?                 @default(false)
  is_active              Boolean?                 @default(true)
  maintenance_status     String?                  @default("available") @db.VarChar(20)
  created_at             DateTime?                @default(now()) @db.Timestamp(6)
  block                  String?                  @db.VarChar(10)
  hall_number            String?                  @db.VarChar(10)
  complaints             complaints[]
  favorite_halls         favorite_halls[]
  hall_usage_logs        hall_usage_logs[]
  timetable              timetable[]
  update_request_pings   update_request_pings[]
  volunteer_hall_updates volunteer_hall_updates[]
  hall_requests          hall_requests[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notifications {
