generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model complaints {
  complaint_id   Int       @id @default(autoincrement())
  student_id     String?   @db.VarChar(20)
  hall_name      String?   @db.VarChar(20)
  issue_category String?   @db.VarChar(50)
  description    String?
  photo_url      String?
  status         String?   @default("Pending") @db.VarChar(20)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  halls          halls?    @relation(fields: [hall_name], references: [hall_name], onDelete: NoAction, onUpdate: NoAction)
  students       students? @relation(fields: [student_id], references: [student_id], onDelete: NoAction, onUpdate: NoAction)
}

model halls {
  hall_name  String       @id @db.VarChar(20)
  capacity   Int?
  hall_type  String?      @db.VarChar(50)
  projector  Boolean?     @default(false)
  plugs      Boolean?     @default(false)
  wifi       Boolean?     @default(false)
  building   String?      @db.VarChar(50)
  complaints complaints[]
}

model students {
  student_id String       @id @db.VarChar(20)
  name       String       @db.VarChar(100)
  mobile     String       @db.VarChar(15)
  email      String       @unique @db.VarChar(150)
  password   String       @db.VarChar(255)
  created_at DateTime?    @default(now()) @db.Timestamp(6)
  complaints complaints[]
}
